{
  "schemaVersion": 1,
  "id": "constructionaddon",
  "version": "${version}",
  "name": "Construction Machinery Addon",
  "description": "Adds working construction machinery to Tudur's Vehicle Mod: excavators that dig, cranes that lift, bulldozers that grade, pile drivers, low-loader trailers, dump trucks and concrete mixer trucks.",
  "authors": [ "Tuduraw" ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/constructionaddon/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [ "com.example.constructionaddon.ConstructionAddon" ],
    "client": [ "com.example.constructionaddon.client.ConstructionAddonClient" ]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "fabric-api": "*",
    "minecraft": "1.21.11",
    "java": ">=21",
    "tudursvehiclemod": ">=1.0.3"
  },
  "mixins": [
    {
      "config": "constructionaddon.client.mixins.json",
      "environment": "client"
    }
  ]
}
